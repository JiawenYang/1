# ============================================================================
# ZZ MD role entity patch
# 补齐缺失的 <TAG>_MD_<role>_entity，使新建营（ZZ 系列）与 MD 原版单位
# 在 sprite = MD_<role> 时能解析到本国专属 3D 模型，而非回退通用模型。
# clone 源均为该国家已有的同兵种营实体（语义一致：# 车 + 人 两部件）。
# ============================================================================

entity = {
	name = "CHI_MD_mechanized_entity"
	clone = "CHI_Mech_Inf_Bat_entity"
}
