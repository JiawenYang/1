# ============================================================================
# ZZ battalion entity bindings (unit-ID family + sprite family)
# HOI4 sub_unit 3D model lookup: <TAG>_<ID>_entity -> <graphics_culture>_<ID>_entity
# -> <ID>_entity. Both <TAG>_<unitID>_entity and <TAG>_<sprite>_entity are
# emitted so the new battalions resolve under either convention.
# clone source = the same-country entity of the matching role.
# ============================================================================
# ==== Generic fallback templates (no TAG prefix) ====
# Used by countries without a dedicated syn ladder; sprite-family fallback.
entity = {
	name = "syn_heavy_bat_entity"
	clone = "MD_light_armor_entity"
}
entity = {
	name = "syn_heavy_bat_entity_desert"
	clone = "MD_light_armor_entity_desert"
}
entity = {
	name = "syn_medium_bat_entity"
	clone = "MD_mechanized_entity"
}
entity = {
	name = "syn_medium_bat_entity_desert"
	clone = "MD_mechanized_entity_desert"
}
entity = {
	name = "syn_light_bat_entity"
	clone = "MD_motorized_entity"
}
entity = {
	name = "syn_light_bat_entity_desert"
	clone = "MD_motorized_entity_desert"
}
entity = {
	name = "syn_amphibious_bat_entity"
	clone = "MD_mechanized_entity"
}
entity = {
	name = "syn_amphibious_bat_entity_desert"
	clone = "MD_mechanized_entity_desert"
}

